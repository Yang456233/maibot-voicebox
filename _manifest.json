{
  "manifest_version": 2,
  "id": "github.Yang456233.maibot-voicebox",
  "version": "0.1.0",
  "name": "麦麦声匣",
  "description": "Edge 与 IndexTTS 角色语音：会话绑定、情绪预设、中日翻译与语音回复。",
  "author": {"name": "Yang456233", "url": "https://github.com/Yang456233"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/Yang456233/maibot-voicebox", "issues": "https://github.com/Yang456233/maibot-voicebox/issues"},
  "host_application": {"min_version": "1.3.14", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.16.99"},
  "dependencies": [{"type": "python_package", "name": "edge-tts", "version_spec": ">=7.0,<8"}, {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.10,<4"}],
  "capabilities": ["send.custom", "send.text", "llm.generate"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
